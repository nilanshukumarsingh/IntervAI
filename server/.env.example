# Server Environment Variables Example
# Copy this file to .env and replace the values with your actual credentials

PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/intervai?retryWrites=true&w=majority
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Firebase Web API Key (for Google Auth token verification)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# OpenRouter AI Key (for Interview Questioning & Evaluation)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Razorpay Payment Gateway (for Credits Purchase)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Nodemailer Email Configuration (for OTP Password Reset)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_here
